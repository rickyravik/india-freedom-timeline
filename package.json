{
  "name": "india-freedom-timeline",
  "private": true,
  "version": "1.0.0",
  "description": "India's Freedom Timeline — an immersive, interactive journey through the people, movements and events of India's struggle for independence.",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:summaries",
    "dev": "vite",
    "build": "npm run generate:summaries && npm run validate && npm run search:check && npm run typecheck && vite build && node scripts/prerender.mjs && tsx scripts/og-images.ts && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.worker.json",
    "generate:summaries": "tsx scripts/generate-summaries.ts",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "validate": "tsx scripts/validate-content.ts",
    "search:check": "tsx scripts/search-check.ts",
    "test:unit": "vitest run",
    "test": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/archivo-narrow": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/faustina": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "workbox-core": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.24",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.129.1",
    "zod": "^4.5.4"
  }
}

{
  // Static-assets Worker: there is no server code, so no "main" entrypoint.
  // Cloudflare serves ./dist directly and handles SPA routing itself.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "india-freedom-timeline",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    // Every unmatched path returns index.html so react-router can route it,
    // which is what public/_redirects does on Pages.
    "not_found_handling": "single-page-application"
  }
}
